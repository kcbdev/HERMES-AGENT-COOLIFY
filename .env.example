# =============================================================================
# .env.example — Hermes Agent on Coolify
# =============================================================================
# Copy to .env and fill in values BEFORE running init-hermes.sh
# In Coolify, paste these into the Environment Variables tab instead.
# =============================================================================

# ── Volume ────────────────────────────────────────────────────────────────────
# Host path where all agent state is persisted
HERMES_DATA_PATH=/data/hermes

# ── Domain ────────────────────────────────────────────────────────────────────
# The domain where Hermes will be accessible (used in setup instructions)
HERMES_DOMAIN=hermes.domain.ma

# ── Volume permissions ────────────────────────────────────────────────────────
# Must match the UID/GID of the host user that owns HERMES_DATA_PATH
# Run: id -u && id -g  to find yours
HERMES_UID=1000
HERMES_GID=1000

# ── API Server auth (required for Hermes Desktop) ────────────────────────────
# Strong random string — this is the "password" Hermes Desktop will use
# Generate: openssl rand -hex 32
API_SERVER_KEY=changeme-replace-with-a-strong-secret

# ── Model provider — fill in ONE block ───────────────────────────────────────

# OpenRouter (recommended)
OPENROUTER_API_KEY=sk-or-v1-xxxx

# Anthropic (optional / alternative)
ANTHROPIC_API_KEY=

# OpenAI (optional / alternative)
OPENAI_API_KEY=

# Local LLM endpoint (Ollama, vLLM, LM Studio, llama.cpp)
# Leave blank if using a cloud provider
OPENAI_BASE_URL=
